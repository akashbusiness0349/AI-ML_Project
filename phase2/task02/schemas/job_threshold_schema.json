{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaceMux Job Skill Threshold Schema",
  "type": "object",
  "required": [
    "job_id",
    "title",
    "skill_thresholds"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "skill_thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  },
  "additionalProperties": true
}