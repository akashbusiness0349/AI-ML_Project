{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RankedList",
  "type": "object",
  "required": [
    "ranked_list_id",
    "request_id",
    "user_id",
    "model_version",
    "created_at",
    "results"
  ],
  "properties": {
    "ranked_list_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "user_id": {
      "type": "string",
      "minLength": 1
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "item_id",
          "position",
          "score",
          "model_version"
        ],
        "properties": {
          "item_id": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "minimum": 1
          },
          "score": {
            "type": "number"
          },
          "model_version": {
            "type": "string"
          }
        }
      }
    }
  }
}