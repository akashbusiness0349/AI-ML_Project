{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Job Description",
  "type": "object",
  "required": [
    "job_id",
    "title",
    "description",
    "requirements"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}